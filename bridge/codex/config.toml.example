model = "arena-agent"
model_provider = "arena"
model_context_window = 128000
approval_policy = "never"
sandbox_mode = "read-only"

[model_providers.arena]
name = "Arena"
base_url = "http://127.0.0.1:17893/v1"
env_key = "ARENA_API_KEY"
wire_api = "responses"

[tui]
screen_reader_detection_done = true

